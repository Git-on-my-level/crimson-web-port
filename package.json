{
  "name": "crimson-web-port",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:copy": "node scripts/copy-assets.mjs",
    "dev": "npm run assets:copy && vite",
    "dev:real": "REAL_ASSETS=1 VITE_USE_REAL_ASSETS=1 npm run dev",
    "build": "npm run assets:copy && tsc && vite build",
    "build:real": "REAL_ASSETS=1 VITE_USE_REAL_ASSETS=1 npm run build",
    "check:types": "tsc --noEmit",
    "check:build": "vite build --emptyOutDir",
    "verify": "npm run check:types && npm run check:build",
    "prepare": "husky install",
    "test": "vitest run",
    "preview": "npm run assets:copy && vite preview",
    "preview:real": "npm run build:real && vite preview",
    "tools:extract-ref": "tsx src/tools/extract_ref_map.ts",
    "tools:extract-quests": "tsx src/tools/extract_quest_names.ts",
    "parity:run": "tsx src/tools/parity_run.ts",
    "parity:extract-ref": "tsx src/tools/extract_ref_specs.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.14",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
