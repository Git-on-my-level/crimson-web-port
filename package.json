{
  "name": "crimson-web-port",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:types": "tsc --noEmit",
    "check:build": "vite build --emptyOutDir",
    "verify": "npm run check:types && npm run check:build",
    "prepare": "husky install",
    "test": "vitest run",
    "preview": "vite preview",
    "tools:extract-ref": "tsx src/tools/extract_ref_map.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.14",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
