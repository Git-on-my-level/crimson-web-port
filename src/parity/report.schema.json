{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/parity-report.schema.json",
  "$defs": {
    "ParityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "message"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skip"]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "expected": {},
        "actual": {},
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ParityRunMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "createdAt"],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "baselineId": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ParityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "meta", "findings"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "meta": {
          "$ref": "#/$defs/ParityRunMeta"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParityFinding"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/ParityReport"
}
